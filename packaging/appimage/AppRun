#!/bin/sh
# Jace Browser AppImage entry point.
HERE="$(dirname "$(readlink -f "$0")")"
export MOZ_APP_LAUNCHER="${APPIMAGE:-$HERE/AppRun}"
# An AppImage runs from a new temporary folder every time. Firefox normally
# gives each install folder its own profile, so every start looked like a new
# install with an empty profile (your data "gone"). One profile for every run:
export MOZ_LEGACY_PROFILES=1
# Updating the AppImage must not be refused as a "downgrade" of that profile.
export MOZ_ALLOW_DOWNGRADE=1
exec "$HERE/usr/lib/jace/jace" "$@"
